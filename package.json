{
  "name": "wordos",
  "version": "1.5.1",
  "private": true,
  "description": "WordOS: an Android app for learning English, built as a tiny desktop OS in a WebView",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "copy": "npm run build && cap sync android",
    "open": "cap open android",
    "apk": "npm run copy && cd android && ./gradlew assembleDebug",
    "icons": "node scripts/gen-icons.mjs",
    "screenshots": "npm run build && node scripts/screenshots.mjs"
  },
  "keywords": [
    "english",
    "vocabulary",
    "spaced-repetition",
    "capacitor",
    "android",
    "typescript",
    "llm"
  ],
  "author": "mirendex",
  "license": "MIT",
  "dependencies": {
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "playwright": "^1.63.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mirendex/wordos.git"
  },
  "homepage": "https://github.com/mirendex/wordos#readme",
  "bugs": {
    "url": "https://github.com/mirendex/wordos/issues"
  }
}
